<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{4A1F6D38-2C7B-4E5A-9D10-7F3B8C62E4A9}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="SSHSnippetsKeeper.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Tests\SSHSnippetsKeeperTests.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="SSHSnippetsKeeper">
        <MSBuild Projects="SSHSnippetsKeeper.dproj"/>
    </Target>
    <Target Name="SSHSnippetsKeeper:Clean">
        <MSBuild Projects="SSHSnippetsKeeper.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SSHSnippetsKeeper:Make">
        <MSBuild Projects="SSHSnippetsKeeper.dproj" Targets="Make"/>
    </Target>
    <Target Name="SSHSnippetsKeeperTests">
        <MSBuild Projects="Tests\SSHSnippetsKeeperTests.dproj"/>
    </Target>
    <Target Name="SSHSnippetsKeeperTests:Clean">
        <MSBuild Projects="Tests\SSHSnippetsKeeperTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SSHSnippetsKeeperTests:Make">
        <MSBuild Projects="Tests\SSHSnippetsKeeperTests.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="SSHSnippetsKeeper;SSHSnippetsKeeperTests"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="SSHSnippetsKeeper:Clean;SSHSnippetsKeeperTests:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="SSHSnippetsKeeper:Make;SSHSnippetsKeeperTests:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
